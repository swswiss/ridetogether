<%#
  Arhivă ture trecute — app/views/.../index.html.erb (sau parțial)
  Presupune în controller:
    @pagy, @past_events = pagy(
      Event.where("date < ?", Date.current).order(date: :desc, time: :desc),
      items: 15
    )
  (ajustează scope-ul după nevoie: pe grup, pe oraș, pe user etc.)
%>

<style>
  :root { --ink: #1a1a1a; --muted: #9a9a9a; --faint: #c4c4c4; --line: #eee; --line-soft: #f4f4f4; --hover: #fafafa; --accent: #e5533d; }

  .a-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); text-decoration: none; margin-bottom: 22px; transition: color .15s; }
  .a-back:hover { color: var(--ink); }
  .a-head { margin-bottom: 26px; }
  .a-head-eyebrow { font-size: 13px; color: var(--accent); font-weight: 500; margin-bottom: 6px; }
  .a-head h1 { font-size: 30px; font-weight: 300; letter-spacing: -0.02em; }

  /* filters */
  .a-filters { display: flex; gap: 10px; margin-bottom: 34px; flex-wrap: wrap; }
  .a-chip { font-size: 13.5px; padding: 8px 18px; border-radius: 100px; border: 1px solid var(--line); color: var(--muted); cursor: pointer; background: #fff; text-decoration: none; transition: all .15s; }
  .a-chip:hover { border-color: #ddd; color: var(--ink); }
  .a-chip.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  .a-month { font-size: 12px; color: var(--faint); text-transform: uppercase; letter-spacing: 0.1em; margin: 28px 0 6px; }
  .a-month:first-of-type { margin-top: 0; }

  /* NEW: grid of rides — 3 columns on desktop */
  .a-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }

  /* rides become bordered cards inside the grid */
  .a-ride { display: block; padding: 16px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); transition: border-color .15s, transform .15s; }
  .a-ride:hover { border-color: #ddd; transform: translateY(-2px); background: #fff; }
  .a-ride > div:first-child { min-width: 0; }
  .a-ride-top { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap; }
  .a-ride-title { font-size: 15.5px; font-weight: 500; }
  .a-ride-type { font-size: 11.5px; color: var(--muted); border: 1px solid var(--line); padding: 2px 9px; border-radius: 100px; white-space: nowrap; }
  .a-ride-meta { font-size: 12.5px; color: var(--muted); overflow-wrap: anywhere; line-height: 1.5; }

  .a-empty { padding: 48px 20px; text-align: center; border: 1px dashed var(--line); border-radius: 14px; }
  .a-empty p { font-size: 14px; color: var(--muted); }

  /* pagination (Pagy) */
  .a-pagination { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 36px; padding-top: 24px; flex-wrap: wrap; }
  .a-pagination .pagy .page a,
  .a-pagination .pagy .page.active a,
  .a-pagination .pagy .prev a,
  .a-pagination .pagy .next a,
  .a-pagination .pagy .prev.disabled,
  .a-pagination .pagy .next.disabled,
  .a-pagination a, .a-pagination span {
    min-width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;
    padding: 0 12px; border: 1px solid var(--line); background: #fff; color: var(--ink);
    border-radius: 10px; font-size: 14px; text-decoration: none; transition: all .15s;
  }
  .a-pagination a:hover { border-color: var(--ink); }
  .a-pagination .active, .a-pagination .current { background: var(--ink); color: #fff; border-color: var(--ink); }
  .a-pagination .gap { border: none; color: var(--faint); min-width: auto; }
  .a-pagination .disabled { color: var(--faint); pointer-events: none; }
  .a-page-info { text-align: center; font-size: 12.5px; color: var(--faint); margin-top: 12px; }

  /* tablet: 2 columns */
  @media (max-width: 900px) {
    .a-grid { grid-template-columns: repeat(2, 1fr); }
  }
  /* mobile: back to 1 column, rows like before */
  @media (max-width: 760px) {
    .inner { padding: 24px 16px 96px; }
    .a-head h1 { font-size: 25px; }
    .a-grid { grid-template-columns: 1fr; gap: 0; }
    .a-ride { border: none; border-bottom: 1px solid var(--line-soft); border-radius: 0; padding: 16px 4px; }
    .a-ride:hover { transform: none; border-color: transparent; border-bottom-color: var(--line-soft); background: var(--hover); }
  }
</style>

  <%= link_to group_path(@group), class: "a-back" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    Înapoi
  <% end %>

  <div class="a-head">
    <h1>Arhivă</h1>
  </div>

  <% if @past_events.any? %>
    <%# grupăm pe „Luna An" în ordinea în care vin (deja sortate desc) %>
    <% @past_events.group_by { |e| I18n.l(e.date, format: "%B %Y").capitalize }.each do |month_label, events| %>

      <p class="a-month"><%= month_label %></p>

      <div class="a-grid">
        <% events.each do |event| %>
          <%= link_to group_event_path(event.group, event), class: "a-ride" do %>
            <div>
              <div class="a-ride-top">
                <span class="a-ride-title"><%= event.title %></span>
                <span class="a-ride-type"><%= event.ride_type.downcase %></span>
              </div>
              <div class="a-ride-meta">
                <%= I18n.l(event.date, format: "%-d %b") %> ·
                <%= event.time.strftime("%H:%M") %> ·
                <%= event.start_location %> ·
                <%= event.distance_km.to_i %> km ·
                <%= event.average_speed_kmh.to_i %> km/h
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

    <% end %>

    <%# paginare Pagy %>
    <div class="a-pagination">
      <%== @pagy.series_nav if @pagy.pages > 1 %>
    </div>

    <p class="a-page-info">
      Pagina <%= @pagy.page %> din <%= @pagy.pages %> · <%= @pagy.count %> ture arhivate
    </p>

  <% else %>
    <div class="a-empty">
      <p>Nu există ture arhivate încă.</p>
    </div>
  <% end %>
