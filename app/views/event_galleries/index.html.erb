<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RideTogether — Grupul amuzanților</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root { --ink:#1a1a1a; --muted:#9a9a9a; --faint:#c4c4c4; --line:#eee; --line-soft:#f4f4f4; --hover:#fafafa; --accent:#e5533d; --danger:#d1382c; }
  .g-back { display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--muted); text-decoration:none; margin-bottom:20px; }
  .g-back:hover { color:var(--ink); }
  .g-head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:20px; flex-wrap:wrap; }
  .g-title { font-size:27px; font-weight:300; letter-spacing:-0.02em; margin-bottom:4px; }
  .g-sub { font-size:14.5px; color:var(--muted); }
  .g-actions { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .g-upload-btn { display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:500; color:#fff; background:#1a1a1a; border:none; cursor:pointer; padding:11px 20px; border-radius:100px; font-family:inherit; white-space:nowrap; }
  .g-upload-btn:hover { opacity:.85; }
  .g-upload-btn:disabled { background:var(--faint); cursor:not-allowed; }
  .g-clear { font-size:13px; color:var(--danger); background:#fff; border:1px solid #e8bbb6; padding:10px 16px; border-radius:100px; cursor:pointer; font-family:inherit; }
  .g-clear:hover { background:var(--danger); color:#fff; border-color:var(--danger); }
  .g-clear form { margin:0; }

  /* progres upload */
  .up-area { margin-bottom:18px; }
  .up-row { display:flex; align-items:center; gap:10px; padding:6px 0; font-size:12.5px; color:var(--muted); }
  .up-name { flex:0 0 auto; max-width:120px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .up-bar { flex:1; height:6px; background:var(--line-soft); border-radius:100px; overflow:hidden; }
  .up-fill { display:block; height:100%; width:0; background:var(--accent); transition:width .2s; }
  .up-pct { flex:0 0 auto; width:40px; text-align:right; }
  .up-error .up-pct { color:var(--danger); }

  /* grila — poze MICI: mai multe coloane, mai mici */
  .g-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; }
  .g-item { position:relative; aspect-ratio:1/1; border-radius:10px; overflow:hidden; background:var(--line-soft); cursor:pointer; }
  .g-item img { width:100%; height:100%; object-fit:cover; display:block; }
  .g-item .play { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; }
  .g-item .play svg { width:36px; height:36px; color:#fff; filter:drop-shadow(0 1px 3px rgba(0,0,0,0.5)); }
  .g-item-del { position:absolute; top:6px; right:6px; width:26px; height:26px; border:none; border-radius:50%; background:rgba(0,0,0,0.55); color:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity .15s; z-index:2; }
  .g-item:hover .g-item-del { opacity:1; }
  .g-item-del form { margin:0; }

  .g-empty { border:1px dashed var(--line); border-radius:16px; padding:48px 20px; text-align:center; }
  .g-empty p { font-size:14px; color:var(--muted); }

  /* mobil: poze mici tot pe 3 coloane (nu 1 — sunt mici oricum) */
  @media (max-width:600px) { .g-grid { grid-template-columns:repeat(3, 1fr); gap:6px; } }

  /* ===== LIGHTBOX ===== */
  .lightbox { position:fixed; inset:0; background:rgba(10,10,10,0.92); z-index:1000; display:none; align-items:center; justify-content:center; padding:20px; }
  .lightbox.open { display:flex; }
  .lightbox img, .lightbox video { max-width:100%; max-height:90vh; border-radius:8px; object-fit:contain; }
  .lb-close { position:absolute; top:18px; right:18px; width:44px; height:44px; border:none; background:rgba(255,255,255,0.12); color:#fff; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .lb-close:hover { background:rgba(255,255,255,0.25); }
  .lb-nav { position:absolute; top:50%; transform:translateY(-50%); width:44px; height:44px; border:none; background:rgba(255,255,255,0.12); color:#fff; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .lb-nav:hover { background:rgba(255,255,255,0.25); }
  .lb-prev { left:18px; }
  .lb-next { right:18px; }
  @media (max-width:600px) { .lb-nav { width:38px; height:38px; } .lb-prev { left:8px; } .lb-next { right:8px; } }
</style>
</head>

<div class="inner"
     data-controller="gallery-upload lightbox"
     data-gallery-upload-signature-url-value="<%= group_event_gallery_signature_path(@group, @event) %>"
     data-gallery-upload-create-url-value="<%= group_event_gallery_photos_path(@group, @event) %>">

  <%= link_to group_event_path(@group, @event), class: "g-back" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    <%= @event.title %>
  <% end %>

  <div class="g-head">
    <div>
      <h1 class="g-title">Galerie</h1>
      <p class="g-sub"><%= @photos.size %> / <%= EventPhoto::MAX_PER_EVENT %> fișiere</p>
    </div>
    <div class="g-actions">
      <%# șterge tot — doar organizatorul, doar dacă există poze %>
      <% if @event.user_id == Current.user.id && @photos.any? %>
        <div class="g-clear">
          <%= button_to group_event_gallery_destroy_all_path(@group, @event),
                method: :delete,
                form: { data: { turbo_confirm: "Sigur ștergi TOATE fișierele? Nu se pot recupera." } } do %>
            Șterge tot
          <% end %>
        </div>
      <% end %>

      <%# upload — dezactivat dacă s-a atins limita %>
      <input type="file" accept="image/*,video/*" multiple hidden
             data-gallery-upload-target="input"
             data-action="change->gallery-upload#upload">
      <button type="button" class="g-upload-btn"
              data-action="gallery-upload#open"
              <%= "disabled" unless @can_upload %>>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        <%= @can_upload ? "Adaugă (#{@remaining} rămase)" : "Limită atinsă" %>
      </button>
    </div>
  </div>

  <div class="up-area" data-gallery-upload-target="progress"></div>

  <% if @photos.any? %>
    <div class="g-grid" id="gallery-grid">
      <% @photos.each do |photo| %>
        <%= render "event_galleries/photo", photo: photo %>
      <% end %>
    </div>
  <% else %>
    <div class="g-empty" id="gallery-grid">
      <p>Niciun fișier încă. Adaugă poze sau video de la tură!</p>
    </div>
  <% end %>

  <%# ===== LIGHTBOX overlay ===== %>
  <div class="lightbox" data-lightbox-target="overlay" data-action="click->lightbox#backdrop">
    <button class="lb-close" data-action="lightbox#close" aria-label="Închide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <button class="lb-nav lb-prev" data-action="lightbox#prev" aria-label="Anterior">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div data-lightbox-target="content"></div>
    <button class="lb-nav lb-next" data-action="lightbox#next" aria-label="Următor">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>
</div>
</html>