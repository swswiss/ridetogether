<%# app/views/posts/_post.html.erb %>
<%#
  Reply-urile NU mai sunt randate aici. În locul lor e un turbo_frame gol,
  cu un link care îl încarcă din backend (acțiunea replies#index) abia la click.
  Astfel, la încărcarea paginii show, reply-urile NU ating baza de date.
%>
<div class="post" id="<%= dom_id(post) %>" data-controller="replies">

  <div class="post-head">
    <div class="post-av">
      <%= group_initials(post.user.name) %>
    </div>

    <div>
      <span class="post-author">
        <%= post.user.name %>
      </span>

      <span class="post-time">
        · <%= time_ago_in_words(post.created_at) %> în urmă
      </span>
    </div>

    <% if post.user_id == Current.user.id %>
      <%= button_to "Șterge",
          group_event_post_path(@group, @event, post),
          method: :delete,
          class: "post-delete",
          form: {
            data: {
              turbo_confirm: "Ești sigur că vrei să ștergi această postare?"
            }
          } %>
    <% end %>
  </div>

  <div class="post-body">
    <%= post.body %>
  </div>

  <div class="post-actions">
    <%# butonul de like — extras în partial, actualizat prin Turbo Stream %>
    <%= render "posts/like_button", post: post %>

    <%# butonul de răspuns (lazy load reply-uri) %>
    <button type="button"
            class="post-action"
            data-action="replies#toggle">
      Răspunde · <%= post.post_replies_count || post.post_replies.size %>
    </button>
  </div>

  <%# ── panoul e ascuns; când se deschide, turbo-frame-ul își încarcă src-ul ── %>
  <div data-replies-target="panel" hidden>
    <%= turbo_frame_tag dom_id(post, :replies),
          src: group_event_post_replies_path(@group, @event, post),
          loading: :lazy do %>
      <p class="replies-loading">Se încarcă răspunsurile…</p>
    <% end %>
  </div>

</div>
