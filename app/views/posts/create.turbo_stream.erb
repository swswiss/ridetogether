<%= turbo_stream.append "event-posts" do %>
  <%= render "posts/post", post: @post %>
<% end %>

<%= turbo_stream.replace "new_post" do %>
  <%= form_with model: @event.posts.build,
                url: group_event_posts_path(@group, @event),
                id: "new_post" do |form| %>

    <%= form.text_area :body,
          placeholder: "Întreabă ceva despre tură...",
          autocomplete: "off" %>

    <div class="composer-foot">
      <div class="composer-tools">
        <button type="button"
                class="composer-tool"
                title="Adaugă poză">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 15l5-5 4 4 3-3 6 6"/>
            <circle cx="9" cy="9" r="1.5"/>
          </svg>
        </button>
      </div>

      <%= form.submit "Postează", class: "composer-post" %>
    </div>

  <% end %>
<% end %>
