<div class="head">
  <div>
    <p class="greeting">Bună, <%=Current.user.name%></p>
    <h1>Iași <span class="chev">▾</span></h1>
  </div>
  <button class="btn-primary">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    Creează o tură
  </button>
</div>

<div class="filters">
  <button class="chip active">Toate</button>
  <button class="chip">MTB</button>
  <button class="chip">Cursieră</button>
  <button class="chip">Plimbare</button>
</div>

<p class="section-label">Urmează</p>

<div class="ride">
  <div class="ride-main">
    <div class="ride-top">
      <span class="ride-title">Tura de sâmbătă dimineața</span>
      <span class="ride-type">cursieră</span>
    </div>
    <span class="ride-meta">Sâm, 22 aug · 10:00<span class="dot">·</span>start Rosetti<span class="dot">·</span>45 km · 28 km/h</span>
  </div>
  <div class="ride-right">
    <div class="going">
      <div class="mini-av" style="background:#eef1fb; color:#3a5bbf;">AS</div>
      <div class="mini-av" style="background:#f0edfb; color:#6a4fb0; margin-left:-8px;">MR</div>
      <div class="mini-av" style="background:#f2f2f2; color:#888; margin-left:-8px;">+9</div>
      <span class="going-count">11 vin</span>
    </div>
    <button class="btn-rsvp filled">Vin</button>
  </div>
</div>

<div class="ride">
  <div class="ride-main">
    <div class="ride-top">
      <span class="ride-title">Trail în pădurea Bârnova</span>
      <span class="ride-type">mtb</span>
    </div>
    <span class="ride-meta">Dum, 23 aug · 09:00<span class="dot">·</span>start Bârnova<span class="dot">·</span>22 km · 18 km/h</span>
  </div>
  <div class="ride-right">
    <div class="going">
      <div class="mini-av" style="background:#eaf3de; color:#5a7d2a;">DP</div>
      <div class="mini-av" style="background:#f2f2f2; color:#888; margin-left:-8px;">+5</div>
      <span class="going-count">6 vin</span>
    </div>
    <button class="btn-rsvp outline">Vin</button>
  </div>
</div>

<div class="ride">
  <div class="ride-main">
    <div class="ride-top">
      <span class="ride-title">Tur relaxat prin Copou</span>
      <span class="ride-type">plimbare</span>
    </div>
    <span class="ride-meta">Mar, 25 aug · 18:30<span class="dot">·</span>start Copou<span class="dot">·</span>12 km · 15 km/h</span>
  </div>
  <div class="ride-right">
    <div class="going">
      <div class="mini-av" style="background:#faeeda; color:#96690f;">IB</div>
      <div class="mini-av" style="background:#f2f2f2; color:#888; margin-left:-8px;">+7</div>
      <span class="going-count">8 vin</span>
    </div>
    <button class="btn-rsvp outline">Vin</button>
  </div>
</div>