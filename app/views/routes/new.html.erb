<%# app/views/routes/new.html.erb — desenează un traseu nou %>
<style>
  :root { --ink: #1a1a1a; --muted: #9a9a9a; --faint: #c4c4c4; --line: #eee; --line-soft: #f4f4f4; --hover: #fafafa; --accent: #e5533d; }
  .r-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); text-decoration: none; margin-bottom: 20px; }
  .r-back:hover { color: var(--ink); }
  .r-title { font-size: 27px; font-weight: 300; letter-spacing: -0.02em; margin-bottom: 4px; }
  .r-lede { font-size: 14.5px; color: var(--muted); margin-bottom: 24px; }

  /* harta de desenat */
  .draw-map { height: 440px; width: 100%; border: 1px solid var(--line); border-radius: 14px; margin-bottom: 18px; z-index: 0; }

  .draw-hint { font-size: 13px; color: var(--muted); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
  .draw-hint svg { color: var(--accent); flex-shrink: 0; }

  .save-row { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
  .save-field { flex: 1; min-width: 200px; }
  .save-field label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 7px; }
  .save-field input[type="text"] { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; font-size: 15px; font-family: inherit; }
  .save-field input:focus { outline: none; border-color: var(--ink); }
  .dist-badge { font-size: 14px; color: var(--ink); background: var(--line-soft); padding: 12px 16px; border-radius: 10px; white-space: nowrap; }
  .dist-badge strong { font-weight: 600; }
  .save-btn { background: #1a1a1a; color: #fff; border: none; padding: 13px 28px; border-radius: 100px; font-size: 14.5px; font-weight: 500; cursor: pointer; font-family: inherit; }
  .save-btn:hover { opacity: .85; }

  @media (max-width: 640px) {
    .draw-map { height: 340px; }
    .save-row { flex-direction: column; align-items: stretch; }
    .save-btn { width: 100%; }
  }
</style>

<div class="inner" data-controller="route-draw">
  <%= link_to routes_path, class: "r-back" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    Turele mele
  <% end %>

  <h1 class="r-title">Desenează un traseu</h1>
  <p class="r-lede">Apasă pe hartă ca să pui puncte. Se trage o linie între ele.</p>

  <%# harta unde desenezi %>
  <div class="draw-map" data-route-draw-target="map"></div>

  <div class="draw-hint">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    Folosește unealta de linie (stânga-sus pe hartă). Click pentru fiecare punct, dublu-click ca să termini.
  </div>

  <%= form_with model: @route, url: routes_path do |form| %>
    <%# câmpuri hidden completate de Stimulus %>
    <%= form.hidden_field :coordinates, data: { route_draw_target: "coordinates" } %>
    <%= form.hidden_field :distance_km, data: { route_draw_target: "distance" } %>

    <div class="save-row">
      <div class="save-field">
        <%= form.label :name, "Numele traseului" %>
        <%= form.text_field :name, placeholder: "Tur Copou → Sculeni" %>
      </div>

      <div class="dist-badge">
        Distanță: <strong data-route-draw-target="distanceLabel">0 km</strong>
      </div>

      <%= form.submit "Salvează traseul", class: "save-btn" %>
    </div>
  <% end %>
</div>
