

<%= turbo_frame_tag "group_content" do %>
  <style>
  /* ===== REQUESTS (matches your ERB class names) ===== */
  .requests-header { margin-bottom: 18px; }
  .requests-header h2 { font-size: 18px; font-weight: 500; letter-spacing: -0.01em; }

  .requests-list { display: flex; flex-direction: column; }

  .request-row {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 16px 4px; border-bottom: 1px solid var(--line-soft);
  }
  .request-user { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .request-avatar {
    width: 40px; height: 40px; border-radius: 50%; background: var(--line-soft);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 500; color: var(--muted); flex-shrink: 0;
  }
  .request-user > div { min-width: 0; }
  .request-user strong { font-size: 14.5px; font-weight: 500; display: block; }
  .request-user span { font-size: 12.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }

  .request-actions { display: flex; gap: 8px; flex-shrink: 0; }
  /* button_to renders a <form> — kill its default margin so buttons align */
  .request-actions form { margin: 0; }
  .btn-accept, .btn-reject {
    padding: 8px 16px; border-radius: 100px; font-size: 13px; font-weight: 500;
    cursor: pointer; font-family: inherit; white-space: nowrap; transition: all .15s;
  }
  .btn-accept { border: none; background: var(--ink); color: #fff; }
  .btn-accept:hover { opacity: 0.85; }
  .btn-reject { border: 1px solid #e0e0e0; background: #fff; color: var(--muted); }
  .btn-reject:hover { border-color: var(--ink); color: var(--ink); }

  /* rejected section */
  .requests-section { margin-top: 36px; }
  .requests-section-header { margin-bottom: 12px; }
  .requests-section-header h3 { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 500; }
  .request-row-rejected { opacity: 0.6; }

  /* empty state */
  .empty-requests { padding: 40px 20px; text-align: center; border: 1px dashed var(--line); border-radius: 12px; }
  .empty-requests p { font-size: 14px; color: var(--muted); }

  @media (max-width: 400px) {
    .request-user span { max-width: 130px; }
  }
  :focus-visible { outline: 2px solid #1a1a1a; outline-offset: 3px; }
</style>

  <div class="empty-requests">
    <p>Coming soon...</p>
  </div>

<% end %>
