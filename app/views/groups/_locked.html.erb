<div class="locked">
  <div class="lock-ico">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
  </div>
  <h2>Grup privat</h2>
  <% if @group.join_requires_approval == true && @membership.nil? %>
    <p>Trebuie să fii membru ca să vezi evenimentele, feed-ul și discuțiile din acest grup.</p>
    <%= button_to group_membership_path(@group),
                  method: :post,
                  class: "btn-join" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round">
        <path d="M12 5v14M5 12h14"/>
      </svg>
      Cere să te alături
    <% end %>
    <p class="locked-note">Adminul grupului îți va aproba cererea.</p>
  <% elsif @group.join_requires_approval == false %>
    <p>Trebuie să fii membru ca să vezi evenimentele, feed-ul și discuțiile din acest grup.</p>
    <%= button_to group_membership_path(@group),
                  method: :post,
                  class: "btn-join" do %>
      Intra in grup
    <% end %>
  <% elsif @membership&.pending? %>
    <p>Cererea ta este în așteptare.</p>
    <%= button_to group_membership_path(@group),
                  method: :delete,
                  class: "btn-join" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"/>
        <path d="m6 6 12 12"/>
      </svg>
      Anulează cererea
    <% end %>
  <% elsif @membership&.rejected? %>
    <p>Cererea ta a fost respinsa.</p>
  <% elsif @membership&.banned? %>
    <p>Ne pare rau. Ai fost banat pe acest grup.</p>
  <% end %>
</div>


<% if @group.description.present? %>
  <div class="group-about">
    <div class="group-about-label">
      Despre grup
    </div>
    <p class="group-about-text"><%= @group.description %></p>
  </div>
<% end %>

<style>
.group-about {
  margin: 12px auto 0;
  padding-top: 26px;
  border-top: 1px solid var(--line-soft, #f0f0f0);
  text-align: center;
}
.group-about-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--muted, #9a9a9a);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}
.group-about-label .dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--accent, #e5533d);
}
.group-about-text {
  font-size: 14.5px;
  color: var(--ink, #1a1a1a);
  line-height: 1.65;
  margin: 0;
  white-space: pre-line;
}
</style>