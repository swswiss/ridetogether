<div class="g-header">
  <div class="g-avatar"><%= group_initials(@group.name) %></div>
  <div class="g-head-main">
    <div class="g-name-row">
      <span class="g-name"><%= @group.name %></span>
      <% if @membership&.active? %>
        <span class="g-badge"><%= @membership.role %></span>
      <% end %>
    </div>
    <div class="g-meta"><%= @group.city %> · <%= @group.active_members.count%> membri · <%= created_at_label(@group.created_at) %></div>
    <div class="g-types">
      <% @group.ride_types.each do |ride_type| %>
        <span class="g-type"><%= ride_type %></span>
      <% end %>
    </div>
  </div>
  <% if @membership&.active? %>
    <div class="g-action">
    <button class="btn-primary" onclick="document.getElementById('rideModal').classList.add('open')">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Creează un eveniment
    </button>
    </div>
  <% end %>
</div>


<!-- ===== MODAL ===== -->
<div class="modal-overlay" id="rideModal">
<div class="modal">

  <div class="modal-head">
    <h2>Creează o tură</h2>

    <button
      type="button"
      class="modal-close"
      onclick="document.getElementById('rideModal').classList.remove('open')">

      <svg width="18" height="18" viewBox="0 0 24 24"
           fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round"
           stroke-linejoin="round">

        <path d="M18 6L6 18M6 6l12 12"/>

      </svg>
    </button>
  </div>


  <%= form_with model: [@group, Event.new],
                url: group_events_path(@group),
                method: :post,
                local: true do |form| %>

    <div class="modal-body">

      <div class="f-field">
        <%= form.label :title, "Titlul turei" %>

        <%= form.text_field :title,
              placeholder: "Tura de sâmbătă dimineața",
              required: true %>
      </div>


      <div class="f-field">
        <p class="f-label-row">Tipul turei</p>

        <div class="f-chips">

          <span class="f-chip selected"
                data-ride-type="MTB">
            MTB
          </span>

          <span class="f-chip"
                data-ride-type="Cursieră">
            Cursieră
          </span>

          <span class="f-chip"
                data-ride-type="Plimbare">
            Plimbare
          </span>

          <span class="f-chip"
                data-ride-type="Gravel">
            Gravel
          </span>

        </div>

        <%= form.hidden_field :ride_type,
              id: "event_ride_type",
              value: "MTB" %>
      </div>


      <div class="f-field f-2">

        <div>
          <%= form.label :date, "Data" %>

          <%= form.date_field :date,
                required: true %>
        </div>

        <div>
          <%= form.label :time, "Ora" %>

          <%= form.time_field :time,
                required: true %>
        </div>

      </div>

      <div class="f-field f-2">
        <div>
          <label>Durată estimată</label>

          <%= form.select :estimated_duration_minutes,
            [
              ["30 min", 30],
              ["45 min", 45],
              ["1 oră", 60],
              ["1 oră și 15 min", 75],
              ["1 oră și 30 min", 90],
              ["1 oră și 45 min", 105],
              ["2 ore", 120],
              ["2 ore și 30 min", 150],
              ["3 ore", 180],
              ["4 ore", 240],
              ["5 ore", 300]
            ],
            { prompt: "Alege durata" },
            class: "f-select" %>
        </div>
      </div>


      <div class="f-field">

        <%= form.label :start_location, "Punct de start" %>

        <%= form.text_field :start_location,
              placeholder: "Podul Rosetti, Iași",
              required: true %>

      </div>


      <div class="f-field f-2">

        <div>
          <%= form.label :distance_km, "Distanță (km)" %>

          <%= form.number_field :distance_km,
                placeholder: "45",
                step: 0.01 %>
        </div>


        <div>
          <%= form.label :average_speed_kmh,
                "Ritm mediu (km/h)" %>

          <%= form.number_field :average_speed_kmh,
                placeholder: "28",
                step: 0.01 %>
        </div>

      </div>


      <div class="f-field">

        <p class="f-label-row">Regim</p>

        <div class="f-radios">

          <label class="f-radio selected"
                 data-regime="no_drop">

            <span class="dot">
              <i></i>
            </span>

            <span>
              <span class="f-radio-title">
                No-drop
              </span>

              <span class="f-radio-sub">
                Așteptăm pe toți.
              </span>
            </span>

          </label>


          <label class="f-radio"
                 data-regime="drop">

            <span class="dot">
              <i></i>
            </span>

            <span>
              <span class="f-radio-title">
                Drop
              </span>

              <span class="f-radio-sub">
                Fiecare în ritmul lui.
              </span>
            </span>

          </label>

        </div>

        <%= form.hidden_field :regime,
              id: "event_regime",
              value: "no_drop" %>

      </div>


      <div class="f-field"
           style="margin-bottom:0;">

        <%= form.label :description,
              "Detalii (opțional)" %>

        <%= form.text_area :description,
              placeholder: "Ne oprim la cafea la jumate. Aduceți cameră de schimb..." %>

      </div>

    </div>


    <div class="modal-foot">

      <button type="button"
              class="btn-cancel"
              onclick="document.getElementById('rideModal').classList.remove('open')">

        Anulează

      </button>


      <%= form.submit "Publică tura",
            class: "btn-save" %>

    </div>

  <% end %>

</div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  /* =========================================
     RIDE TYPE CHIPS
     ========================================= */

  const rideTypeChips = document.querySelectorAll("[data-ride-type]");
  const rideTypeInput = document.getElementById("event_ride_type");

  rideTypeChips.forEach(function (chip) {
    chip.addEventListener("click", function () {

      // Deselect all
      rideTypeChips.forEach(function (c) {
        c.classList.remove("selected");
      });

      // Select clicked chip
      chip.classList.add("selected");

      // Put selected value into hidden input
      if (rideTypeInput) {
        rideTypeInput.value = chip.dataset.rideType;
      }
    });
  });


  /* =========================================
     REGIME RADIO BUTTONS
     ========================================= */

  const regimeRadios = document.querySelectorAll("[data-regime]");
  const regimeInput = document.getElementById("event_regime");

  regimeRadios.forEach(function (radio) {
    radio.addEventListener("click", function () {

      // Deselect all
      regimeRadios.forEach(function (r) {
        r.classList.remove("selected");
      });

      // Select clicked radio
      radio.classList.add("selected");

      // Put selected value into hidden input
      if (regimeInput) {
        regimeInput.value = radio.dataset.regime;
      }
    });
  });


  /* =========================================
     CLOSE MODAL - CLICK ON OVERLAY
     ========================================= */

  const rideModal = document.getElementById("rideModal");

  if (rideModal) {
    rideModal.addEventListener("click", function (event) {

      // Only close if clicking the dark overlay,
      // not the modal itself
      if (event.target === rideModal) {
        rideModal.classList.remove("open");
      }

    });
  }


  /* =========================================
     CLOSE MODAL - ESC KEY
     ========================================= */

  document.addEventListener("keydown", function (event) {

    if (event.key === "Escape" && rideModal) {
      rideModal.classList.remove("open");
    }

  });


  /* =========================================
     CANCEL BUTTON
     ========================================= */

  const cancelButton = document.querySelector(".btn-cancel");

  if (cancelButton) {
    cancelButton.addEventListener("click", function () {
      if (rideModal) {
        rideModal.classList.remove("open");
      }
    });
  }


  /* =========================================
     OPEN MODAL
     ========================================= */

  // Dacă ai un buton cu id="openRideModal"
  const openButton = document.getElementById("openRideModal");

  if (openButton) {
    openButton.addEventListener("click", function () {
      rideModal.classList.add("open");
    });
  }


  /* =========================================
     FORM SUBMIT
     ========================================= */

  const form = rideModal
    ? rideModal.querySelector("form")
    : null;

  if (form) {

    form.addEventListener("submit", function () {

      // Prevent accidental double-click
      const submitButton = form.querySelector(
        'button[type="submit"], input[type="submit"]'
      );

      if (submitButton) {
        submitButton.disabled = true;

        if (submitButton.tagName === "INPUT") {
          submitButton.value = "Se publică...";
        } else {
          submitButton.textContent = "Se publică...";
        }
      }

    });

  }

});
</script>