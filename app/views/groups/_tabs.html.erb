<!-- TAB MENU -->
<div class="tabs" data-controller="tabs">
  <span class="tab" data-tabs-target="tab" data-action="click->tabs#select">Evenimente</span>
  <span class="tab" data-tabs-target="tab" data-action="click->tabs#select">Feed</span>
  <%= link_to group_members_path(@group),
          class: "tab",
          data: { turbo_frame: "group_content", tabs_target: "tab", action: "click->tabs#select", turbo_prefetch: false } do %>

    Membrii

  <% end %>
  <span class="tab" data-tabs-target="tab" data-action="click->tabs#select">Chat</span>
  <% if !@membership&.member? %>
    <%= link_to group_membership_requests_path(@group),
            class: "tab",
            data: { turbo_frame: "group_content", tabs_target: "tab", action: "click->tabs#select", turbo_prefetch: false } do %>

      Cereri

    <% end %>
  <% end %>
  <% if !@membership&.member? %>
    <span class="tab" data-tabs-target="tab" data-action="click->tabs#select">
    <%= link_to group_settings_path(@group),
              class: "tab",
              data: { turbo_frame: "group_content", tabs_target: "tab", action: "click->tabs#select", turbo_prefetch: false } do %>
        Setari

      <% end %>
    </span>
  <% end %>
</div>